# Server
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/laundry?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=180d

# Root Admin seed (used only by `npm run seed:root-admin`)
ROOT_ADMIN_MOBILE=9999999999
ROOT_ADMIN_PASSWORD=change-me-root-password

# Cloudinary (free tier) — create an account at cloudinary.com, cloud name is on the dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging
# Either a path to a service account JSON file, or the JSON itself (inline)
FCM_SERVICE_ACCOUNT_JSON=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
