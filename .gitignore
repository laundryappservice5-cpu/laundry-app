# This root .gitignore is a defense-in-depth safety net.
# Each of backend/, web/, app/ also has its own .gitignore.

# Dependencies
node_modules/

# Environment variables — never commit real secrets
.env
.env.*
!.env.example
!**/.env.example

# Build outputs
dist/
dist-ssr/
build/
coverage/
web-build/

# Expo / React Native
.expo/
*.tsbuildinfo
expo-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Claude Code local project config (personal workflow, not shared source)
.claude/
